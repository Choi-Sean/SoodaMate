# --- App ---
APP_ENV=local
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
# No Docker/local container — point this directly at a real, reachable SQL
# Server instance (see docs/ENV_VARS.md at the repo root). MARS_Connection=yes
# is required or aioodbc throws "Connection is busy with results for another
# command." Connection+Timeout=15 bounds a hung connection attempt.
DATABASE_URL=mssql+aioodbc://user:pass@host:1433/sooda_mate?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes&MARS_Connection=yes&Connection+Timeout=15

# --- Google OAuth ---
# Create a "Web application" OAuth client in Google Cloud Console; the mobile app
# uses this client ID as the audience so the backend can verify id_tokens.
GOOGLE_OAUTH_CLIENT_ID=

# --- Kakao ---
# From Kakao Developers > App > App Keys. Backend just needs to call kapi.kakao.com
# with the access_token the mobile SDK returns, so no server-side secret is required
# for the basic profile-verification flow.
KAKAO_REST_API_KEY=

# --- Apple (Sign In with Apple) ---
# Defaults to the real bundle id already set in mobile/app.config.js — only
# override if the bundle id ever changes. No separate account needed beyond
# the Apple Developer Program membership App Store submission already requires.
APPLE_BUNDLE_ID=com.soodalist.soodamate

# --- GCS (photo storage) ---
GCS_BUCKET_NAME=sooda-mate-photos
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json

# --- Firebase (push notifications) ---
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# --- CORS ---
CORS_ORIGINS=http://localhost:19006,http://localhost:8081

# --- Video call signaling (Phase 15) ---
# STUN is public and needs no account; TURN is an external prerequisite
# (Twilio/coturn/etc.) for reliable calls across restrictive NATs.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Work/school email verification (Phase 16) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@soodamate.example.com

# --- Stripe (web checkout, not in-app purchase) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Deployed marketing site origin (Vercel URL) — used for Stripe Checkout redirects.
WEB_BASE_URL=http://localhost:8080
