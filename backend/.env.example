# --- App ---
APP_ENV=local
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
# Local docker-compose default; replace with Cloud SQL connection string in production
DATABASE_URL=postgresql+asyncpg://suda:suda@localhost:5433/suda_date

# --- Google OAuth ---
# Create a "Web application" OAuth client in Google Cloud Console; the mobile app
# uses this client ID as the audience so the backend can verify id_tokens.
GOOGLE_OAUTH_CLIENT_ID=

# --- Kakao ---
# From Kakao Developers > App > App Keys. Backend just needs to call kapi.kakao.com
# with the access_token the mobile SDK returns, so no server-side secret is required
# for the basic profile-verification flow.
KAKAO_REST_API_KEY=

# --- GCS (photo storage) ---
GCS_BUCKET_NAME=suda-date-photos
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json

# --- Firebase (push notifications) ---
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# --- CORS ---
CORS_ORIGINS=http://localhost:19006,http://localhost:8081
